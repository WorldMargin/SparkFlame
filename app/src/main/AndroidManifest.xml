<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 会话头像：优先从 CDN 拉取，失败则用本地缓存 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:description="@string/spark_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/spark_name">

        <!-- 配置跨进程通道：管理界面（模块进程）写，宿主（抖音进程）读 -->
        <provider
            android:name=".features.autospark.provider.ConfigProvider"
            android:authorities="io.github.worldmargin.sparkflame.config"
            android:exported="true" />

        <!-- 宿主写配置前先唤醒本模块进程（见 WakeReceiver 注释），否则 provider 调不通 -->
        <receiver
            android:name=".features.autospark.provider.WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.worldmargin.autospark.action.WAKE" />
            </intent-filter>
        </receiver>

        <!--
            宿主唤不醒「被系统停用」的模块 App 时的兜底：启动一个透明空页面把进程拉起来
            （广播与 provider 调用对停用状态的应用都会被系统丢掉，启动 Activity 才行）。
        -->
        <activity
            android:name=".WakeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 续火花管理界面：桌面图标入口 + 抖音设置页注入入口（由抖音进程唤起，故需 exported） -->
        <activity
            android:name=".features.autospark.ui.SparkSettingsActivity"
            android:exported="true"
            android:label="@string/spark_name"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.autospark.ui.TemplateEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 模板变量：一行一个（名字 + 两三行高的小 Monaco），结果回传给模板编辑页 -->
        <activity
            android:name=".features.autospark.ui.VariableListActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.autospark.ui.ConversationEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.autospark.ui.SandboxVarsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.autospark.ui.MacroEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.autospark.ui.FunctionEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.autospark.ui.DocsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
